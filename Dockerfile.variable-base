# Scenario: the base image is supplied via an ARG, so the Dockerfile uses
# ``FROM ${BASE_IMAGE}``. The MT cannot determine which family this will
# resolve to at build time.
# Expected MT behaviour: detect_base_family returns "unknown" → POSIX-safe
# fallback RUN block (tries addgroup -S, falls back to groupadd --system).
ARG BASE_IMAGE=python:3.12-slim

FROM ${BASE_IMAGE}

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

ENV FLASK_APP=app
ENV FLASK_RUN_HOST=0.0.0.0

EXPOSE 5000


# Run as a non-root user for container security
RUN (addgroup -S app 2>/dev/null || groupadd --system app) && (adduser -S -u 1001 -G app app 2>/dev/null || useradd --system --uid 1001 --gid app --create-home app)
USER 1001
CMD ["flask", "run"]
