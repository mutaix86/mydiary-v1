# Scenario: ubuntu base, no USER directive.
# Expected MT behaviour: ubuntu family → groupadd / useradd --system + USER 1001.
FROM ubuntu:24.04

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        build-essential \
        libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip3 install --no-cache-dir --break-system-packages -r requirements.txt

COPY . .

ENV FLASK_APP=app
ENV FLASK_RUN_HOST=0.0.0.0

EXPOSE 5000


# Run as a non-root user for container security
RUN groupadd --system app && useradd --system --uid 1001 --gid app --create-home app
USER 1001
CMD ["flask", "run"]
