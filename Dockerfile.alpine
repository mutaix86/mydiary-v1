# Scenario: alpine base, no USER directive.
# Expected MT behaviour: alpine family → addgroup -S / adduser -S + USER 1001.
FROM python:3.12-alpine

WORKDIR /app

RUN apk add --no-cache --virtual .build-deps \
        gcc \
        musl-dev \
        postgresql-dev \
    && apk add --no-cache libpq

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    && apk del .build-deps

COPY . .

ENV FLASK_APP=app
ENV FLASK_RUN_HOST=0.0.0.0

EXPOSE 5000

CMD ["flask", "run"]
