# Auto-detect text files and normalize line endings
* text=auto

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.tif binary
*.tiff binary
*.ico binary
*.webp binary
*.bmp binary
*.psd binary
# SVG is XML text, not binary
*.svg text

# Fonts
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary

# Archives
*.7z binary
*.bz2 binary
*.gz binary
*.rar binary
*.tar binary
*.tar.gz binary
*.zip binary
*.zst binary

# Other binary formats
*.pdf binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary

# Preserve byte sequences in patches
*.patch -text
*.diff -text

# Audio
*.mp3 binary
*.ogg binary
*.wav binary
*.flac binary
*.m4a binary
*.aac binary

# Video
*.mp4 binary
*.avi binary
*.mov binary
*.webm binary
*.mkv binary
*.wmv binary
*.flv binary

# Lockfiles
uv.lock binary
Pipfile.lock binary
poetry.lock binary

# Python bytecode (Python.gitattributes)
*.pyc binary
*.pyo binary
*.pyd binary

# Shell scripts must use LF
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf
*.fish text eol=lf

# Windows scripts must use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Docker
Dockerfile text
Dockerfile.* text

# Diff attributes for better readability
*.md diff=markdown
*.css diff=css
*.scss diff=css
*.html diff=html
*.tex diff=tex

# Document diffs via text extraction
*.doc diff=astextplain
*.DOC diff=astextplain
*.docx diff=astextplain
*.DOCX diff=astextplain
*.pdf diff=astextplain
*.PDF diff=astextplain
*.rtf diff=astextplain
*.RTF diff=astextplain

# Jupyter notebooks (Web.gitattributes, Python.gitattributes)
*.ipynb text eol=lf

# Python diff driver
*.py text diff=python
*.pyx text diff=python

# Linguist: mark generated files
uv.lock linguist-generated=true
Pipfile.lock linguist-generated=true
poetry.lock linguist-generated=true

# Exclude from archives
.github/ export-ignore
.gitlab/ export-ignore
.gitattributes export-ignore
.gitignore export-ignore
