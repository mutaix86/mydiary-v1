# Scenario: final stage is ``FROM runtime-base`` (bare stage alias, no AS) and
# the aliased parent stage already sets a non-root USER. The Grafana pattern.
# Expected MT behaviour: effective_user walks the alias chain and returns
# "appuser" → needs_fix=False → skipped (nothing to do, parent handles it).
FROM python:3.12-slim AS runtime-base

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends libpq-dev \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system appgroup \
    && useradd --system --uid 1001 --gid appgroup --create-home appuser

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY --chown=1001:1001 . .

ENV FLASK_APP=app
ENV FLASK_RUN_HOST=0.0.0.0

USER appuser

EXPOSE 5000

CMD ["flask", "run"]

# Default final stage inherits everything from runtime-base, including USER.
FROM runtime-base
